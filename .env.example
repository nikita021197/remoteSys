# RemoteSys Environment Configuration
# Скопируйте этот файл в .env и заполните значения

# ==================== SERVER ====================
# Порт сервера (по умолчанию 3001)
PORT=3001

# Окружение: development | production
NODE_ENV=production

# ==================== SECURITY ====================
# Секретный ключ для JWT токенов (генерируйте случайно!)
# openssl rand -base64 32
JWT_SECRET=change-me-to-random-string

# Ключ шифрования для паролей (ровно 32 байта / 64 hex символа)
# openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==================== DATABASE (optional) ====================
# PostgreSQL connection string
# DATABASE_URL=postgresql://remotesys:password@localhost:5432/remotesys

# ==================== LOGGING ====================
# Уровень логирования: error | warn | info | debug
LOG_LEVEL=info

# ==================== LIMITS ====================
# Максимум запросов в минуту на IP
RATE_LIMIT_MAX=100

# Таймаут SSH подключения (мс)
SSH_TIMEOUT=15000

# ==================== ADB ====================
# Путь к adb (если не в PATH)
# ADB_PATH=/usr/bin/adb
